        "THONG_TIN_CHUNG.Thong_Tin_Bi_Cao": "[{\"Ho_Ten\": \"H Thị T\", \"Ngay_Sinh\": \"1975-10-22\", \"Noi_Cu_Tru\": \"Thôn Đ, xã C, thành phố L, tỉnh Lào Cai\", \"Nghe_Nghiep\": \"Lao động tự do\", \"Trinh_Do_Van_Hoa\": \"09/12\", \"Dan_Toc\": \"Tày\", \"Gioi_Tinh\": \"Nữ\", \"Ton_Giao\": \"Không\", \"Quoc_Tich\": \"Việt Nam\", \"Hoan_Canh_Gia_Dinh\": \"Con ông H Huy B và bà Doãn Thị A; có 06 con, lớn sinh năm 1997, nhỏ sinh năm 2017\", \"Tien_An\": \"Có 02 tiền án: Bản án số 14/2005/HSST ngày 02/02/2005 xử phạt 02 năm tù về tội Vận chuyển trái phép chất ma túy; Bản án số 102/2008/HSST ngày 25/08/2008 xử phạt 03 năm tù về tội Tàng trữ trái phép chất ma túy\", \"Ngay_Tam_Giam\": \"2024-04-14\", \"Trang_Thai_Co_Mat\": \"Có mặt\"}, {\"Ho_Ten\": \"La Văn S\", \"Ngay_Sinh\": \"1993-08-13\", \"Noi_Cu_Tru\": \"Thôn H, xã G, huyện T, tỉnh Lào Cai\", \"Nghe_Nghiep\": \"Lao động tự do\", \"Trinh_Do_Van_Hoa\": \"Không\", \"Dan_Toc\": \"Tày\", \"Gioi_Tinh\": \"Nam\", \"Ton_Giao\": \"Không\", \"Quoc_Tich\": \"Việt Nam\", \"Hoan_Canh_Gia_Dinh\": \"Con ông La Văn S và bà Phạm Thị T\", \"Tien_An\": \"Không\", \"Tien_Su\": \"Có 01 tiền sự: Quyết định số 81/QĐ-TA ngày 05/11/2021 áp dụng xử lý hành chính đưa vào cơ sở cai nghiện bắt buộc từ ngày 04/10/2021 đến ngày 04/4/2023\", \"Ngay_Tam_Giam\": \"2024-04-13\", \"Trang_Thai_Co_Mat\": \"Có mặt\"}, {\"Ho_Ten\": \"Lò Láo S\", \"Ngay_Sinh\": \"1987-02-28\", \"Noi_Cu_Tru\": \"Thôn M, xã T, thành phố L, tỉnh Lào Cai\", \"Nghe_Nghiep\": \"Lao động tự do\", \"Trinh_Do_Van_Hoa\": \"9/12\", \"Dan_Toc\": \"Dao\", \"Gioi_Tinh\": \"Nam\", \"Ton_Giao\": \"Không\", \"Quoc_Tich\": \"Việt Nam\", \"Hoan_Canh_Gia_Dinh\": \"Con ông Lò Quẩy P và bà Phàn Lở M; Có vợ: Vũ Ngọc T và có 05 con, lớn sinh năm 2006, nhỏ sinh năm 2019\", \"Tien_An\": \"Không\", \"Tien_Su\": \"Không\", \"Chi_Tiet_Nhan_Than\": \"Bản án số 51/2011/HSST ngày 21/12/2011 xử phạt 04 năm 06 tháng tù về tội Mua bán người (đã được xóa án tích)\", \"Ngay_Tam_Giam\": \"2024-04-13\", \"Trang_Thai_Co_Mat\": \"Có mặt\"}, {\"Ho_Ten\": \"Nguyễn Mạnh H\", \"Ngay_Sinh\": \"1994-02-05\", \"Noi_Cu_Tru\": \"Thông Đ, xã C, thành phố L, tỉnh Lào Cai\", \"Nghe_Nghiep\": \"Lao động tự do\", \"Trinh_Do_Van_Hoa\": \"12/12\", \"Dan_Toc\": \"Kinh\", \"Gioi_Tinh\": \"Nam\", \"Ton_Giao\": \"Không\", \"Quoc_Tich\": \"Việt Nam\", \"Hoan_Canh_Gia_Dinh\": \"Con ông Nguyễn Văn H và bà Pham Thị S\", \"Tien_An\": \"Không\", \"Tien_Su\": \"Không\", \"Chi_Tiet_Nhan_Than\": \"Bản án số 32/2018/HSST ngày 26/04/2018 xử 02 năm 06 tháng tù về tội Mua bán trái phép chất ma túy (đã được xóa án tích)\", \"Ngay_Tam_Giam\": \"2024-04-13\", \"Trang_Thai_Co_Mat\": \"Có mặt\"}, {\"Ho_Ten\": \"Nguyễn Thị N\", \"Ngay_Sinh\": \"1996-06-29\", \"Noi_Cu_Tru\": \"Tổ 15, phường M, thành phố L, tỉnh Lào Cai\", \"Nghe_Nghiep\": \"Lao động tự do\", \"Trinh_Do_Van_Hoa\": \"9/12\", \"Dan_Toc\": \"Kinh\", \"Gioi_Tinh\": \"Nữ\", \"Ton_Giao\": \"Không\", \"Quoc_Tich\": \"Việt Nam\", \"Hoan_Canh_Gia_Dinh\": \"Con ông Nguyễn Quốc T và bà Trần Thị H\", \"Tien_An\": \"Không\", \"Tien_Su\": \"Không\", \"Ngay_Tam_Giam\": \"2024-04-13\", \"Trang_Thai_Co_Mat\": \"Có mặt\"}, {\"Ho_Ten\": \"Lương Minh H\", \"Ngay_Sinh\": \"1991-01-27\", \"Noi_Cu_Tru\": \"Tổ 6, phường H, thành phố L, tỉnh Lào Cai\", \"Nghe_Nghiep\": \"Lao động tự do\", \"Trinh_Do_Van_Hoa\": \"12/12\", \"Dan_Toc\": \"Hoa\", \"Gioi_Tinh\": \"Nam\", \"Ton_Giao\": \"Không\", \"Quoc_Tich\": \"Việt Nam\", \"Hoan_Canh_Gia_Dinh\": \"Con ông Lương Ngọc S và bà Đoàn Thị H\", \"Tien_An\": \"Không\", \"Tien_Su\": \"Không\", \"Ngay_Tam_Giam\": \"2024-04-13\", \"Trang_Thai_Co_Mat\": \"Có mặt\"}]",
        "Synthetic_summary_2": "[\"Thưa luật sư, tôi là H Thị T, tôi xin tường trình lại sự việc như sau: Khoảng 09 giờ 00 phút ngày 09/4/2024, tôi gặp một người đàn ông khoảng 50 tuổi tại chợ Kim Tân, thành phố L, tôi đã bỏ ra 02 triệu đồng để mua 01 gói ma túy với mục đích vừa để sử dụng vừa bán kiếm lời. Tôi đem gói ma túy về nhà chị H Thị N tại số 255A đường L, phường B, thành phố L, chia nhỏ thành nhiều gói và cất giấu ở nhiều nơi trong phòng ngủ. Tôi bán ma túy với giá 50.000 đồng một gói qua một lỗ nhỏ trên cửa xếp theo quy ước gọi \\\"Anh Thành ơi\\\". Trong ngày 13/4/2024, tôi đã bán ma túy 03 lần: lần một lúc 09 giờ 30 phút cho La Văn S với giá 300.000 đồng (06 gói), lần hai lúc 11 giờ 20 phút cho Lò Láo S1 và Nguyễn Mạnh H với giá 400.000 đồng (13 gói), và lần ba lúc 16 giờ 30 phút cho Nguyễn Thị N và Lương Minh H với giá 200.000 đồng (04 gói). Cơ quan chức năng đã thu giữ của tôi 116,127 gam Heroine. Tôi biết mình đã phạm tội nhiều lần và từng có tiền án tiền sự nên đây là lần tái phạm nguy hiểm, nhưng tôi thực sự hối hận và thành khẩn khai báo mọi chuyện. Ngoài ra, tôi cũng mong luật sư xem xét giúp tôi vì bà nội tôi là Nguyễn Thị Hiên có được Nhà nước tặng thưởng Huân chương Kháng chiến hạng ba.\", \"Thưa luật sư, tôi là La Văn S. Vào khoảng 09 giờ 30 phút ngày 13/04/2024, tôi đi xe ôm đến nhà H Thị T để mua ma túy (Heroine) về sử dụng. Trên đường đi, tôi có gặp một người bạn tên H và nhờ H chở tôi đến đó. Tôi đã một mình đi vào hiên nhà T, gọi 'anh Thành ơi lấy cho em ba trăm' và đưa 300.000 đồng qua khe nhỏ trên cửa xếp. Sau đó, T nhét ra 01 túi nilon chứa 06 gói ma túy. Tôi cầm gói ma túy này đi đến hiệu thuốc Khánh Linh thuộc tổ 5, phường K, thành phố L để mua xi lanh, thì bị bắt quả tang. Theo kết luận giám định số 163/KL-GĐMT ngày 19/4/2024, số ma túy Heroine thu giữ được của tôi là 0,205 gam. Tôi biết mình đã sai và hiện tại tôi rất hối hận, nên tôi đã thành khẩn khai báo mọi chuyện với cơ quan điều tra.\", \"Thưa luật sư, vào khoảng 15 giờ 00 phút ngày 13/4/2024, tôi có ý định đi mua ma túy về sử dụng nên đã mượn xe mô tô biển kiểm soát 24B1-650.97 của chị gái tôi là Nguyễn Thị H để đi. Tôi có gặp Lương Minh H, và hai chúng tôi bàn nhau góp tiền mua ma túy để dùng chung. Anh H đã đưa cho tôi 100.000 đồng để góp, và khoảng 16 giờ 30 cùng ngày, tôi chở anh H đến số nhà 255A đường Lê Thanh để mua. Tại đây, tôi là người trực tiếp đưa 200.000 đồng qua lỗ nhỏ trên cửa xếp và gọi 'Anh Thành ơi' theo quy ước, sau đó nhận về 04 gói ma túy từ H Thị T. Tuy nhiên, trên đường về đến khu vực tổ 6, phường K, tôi và anh H đã bị bắt quả tang cùng toàn bộ tang vật. Theo kết luận giám định số 164/KL-GĐMT ngày 19/4/2024, số ma túy Heroine thu giữ được của tôi và anh H là 0,169 gam. Tôi biết mình đã sai và hiện tại rất hối hận, thành khẩn khai báo mọi chuyện. Ngoài ra, tôi cũng mong luật sư xem xét giúp tôi vì mẹ đẻ tôi là bà Trần Thị H được Nhà nước tặng thưởng huy chương kháng chiến hạng nhất.\", \"Thưa luật sư, vào khoảng 11 giờ 20 phút ngày 13/4/2024, tôi có gọi điện cho anh Nguyễn Mạnh H làm nghề xe ôm để đón tôi đến đường Hàm Nghi, phường K, sau đó anh H chở tôi đến nhà H Thị T để mua ma túy. Khi đến nơi, anh H vào cửa gọi 'anh Thành ơi' để gọi người bán, còn tôi là người trực tiếp đưa 400.000 đồng qua lỗ nhỏ trên cửa xếp để mua ma túy. Tôi cũng trả cho anh H 200.000 đồng tiền xe ôm. Sau khi nhận được cùng lúc 13 gói ma túy từ H Thị T, tôi bảo anh H chở về phòng trọ của tôi ở đường Mường Than, tổ 13, phường K, nhưng trên đường về thì tôi bị bắt quả tang cùng toàn bộ tang vật. Kết quả giám định cho thấy lượng ma túy Heroine tôi mua là 0,287 gam. Tôi biết mình đã sai và hiện tại tôi rất hối hận, thành khẩn khai báo mọi chuyện với cơ quan điều tra để mong được giảm nhẹ hình phạt.\", \"Thưa luật sư, tôi là Nguyễn Mạnh H, làm nghề xe ôm. Vào khoảng 11 giờ 20 phút ngày 13/4/2024, tôi được Lò Láo S1 gọi điện nhờ đón tại đường Hàm Nghi, phường K để đưa đi mua ma túy. Tôi đồng ý và chở S1 đến nhà H Thị T. Tại đây, tôi là người trực tiếp đi vào cửa nhà T và gọi 'anh Thành ơi bán cho em mấy cái thẻ', sau đó bảo S1 đưa 400.000 đồng qua lỗ nhỏ trên cửa xếp. S1 cũng trả cho tôi 200.000 đồng tiền xe ôm. Sau khi đó, H Thị T nhét ra 13 gói ma túy cho S1. Tôi chở S1 về phòng trọ trên đường Mường Than, tổ 13, phường K thì bị bắt quả tang cùng toàn bộ tang vật, trong đó có 0,287 gam Heroine theo kết luận giám định số 162/KL-GĐMT ngày 19/4/2024. Tôi biết mình đã sai và hiện tại tôi rất hối hận, thành khẩn khai báo mọi chuyện với cơ quan điều tra để mong được giảm nhẹ hình phạt.\", \"Thưa luật sư, vào khoảng 15 giờ 00 phút ngày 13/4/2024, tôi có gặp Nguyễn Thị N tại khu vực ngã ba Công ty thuộc phường M và hai chúng tôi bàn nhau cùng góp tiền đi mua ma túy để sử dụng chung. Tôi đã đưa cho N 100.000 đồng để góp mua ma túy, sau đó N chở tôi đi tìm mua nhưng không thành công, cho đến khi chúng tôi cùng đến số nhà 255A đường Lê Thanh vào lúc 16 giờ 30 cùng ngày. Tại đây, N đã đưa 200.000 đồng qua lỗ nhỏ trên cửa xếp để mua 04 gói ma túy từ H Thị T. Tôi và N cùng đi về thì bị cơ quan chức năng bắt quả tang cùng với 0,169 gam Heroine theo kết luận giám định. Tôi biết mình đã sai và hiện tại tôi rất hối hận, thành khẩn khai báo mọi việc với cơ quan điều tra để mong nhận được sự khoan hồng.\"]"
      },
