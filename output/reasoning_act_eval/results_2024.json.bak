        "THONG_TIN_CHUNG.Thong_Tin_Bi_Cao": "[{\"Ho_Ten\": \"Nguyễn Xuân K\", \"Ngay_Sinh\": \"1981-10-10\", \"Noi_Cu_Tru\": \"Số E N, khóm E, phường C, thành phố C, tỉnh An Giang\", \"Nghe_Nghiep\": \"Kinh doanh\", \"Trinh_Do_Van_Hoa\": \"12/12\", \"Dan_Toc\": \"Kinh\", \"Gioi_Tinh\": \"Nam\", \"Ton_Giao\": \"Không\", \"Quoc_Tich\": \"Việt Nam\", \"Hoan_Canh_Gia_Dinh\": \"con ông Nguyễn Văn H và bà Ngô Bội H1; vợ là Trần Thị Hương T và có 02 con\", \"Tien_An\": \"Không\", \"Tien_Su\": \"Không\", \"Ngay_Tam_Giam\": \"2023-07-27\", \"Trang_Thai_Co_Mat\": \"Có mặt\"}, {\"Ho_Ten\": \"Hà Văn S\", \"Ngay_Sinh\": \"1963-01-01\", \"Noi_Cu_Tru\": \"Tổ F, khóm T, thị trấn L, huyện A, tỉnh An Giang\", \"Nghe_Nghiep\": \"Làm thuê\", \"Trinh_Do_Van_Hoa\": \"không biết chữ\", \"Dan_Toc\": \"Kinh\", \"Gioi_Tinh\": \"Nam\", \"Ton_Giao\": \"Đạo T\", \"Quoc_Tich\": \"Việt Nam\", \"Hoan_Canh_Gia_Dinh\": \"con ông Hà Văn T1 và bà Nguyễn Thị N; vợ là Huỳnh Thị P và có 01 con\", \"Tien_An\": \"Không\", \"Tien_Su\": \"Không\", \"Ngay_Tam_Giam\": \"2023-07-27\", \"Trang_Thai_Co_Mat\": \"Có mặt\"}, {\"Ho_Ten\": \"Nguyễn Tấn P1\", \"Ngay_Sinh\": \"1978-05-10\", \"Noi_Cu_Tru\": \"Tổ F, khóm T, thị trấn L, huyện A, tỉnh An Giang\", \"Nghe_Nghiep\": \"Làm thuê\", \"Trinh_Do_Van_Hoa\": \"không biết chữ\", \"Dan_Toc\": \"Kinh\", \"Gioi_Tinh\": \"Nam\", \"Ton_Giao\": \"Đạo T\", \"Quoc_Tich\": \"Việt Nam\", \"Hoan_Canh_Gia_Dinh\": \"con ông Nguyễn Văn Ở và bà Huỳnh Thị S1; vợ là Huỳnh Thị Thu T2 và có 03 con\", \"Tien_An\": \"Không\", \"Tien_Su\": \"Không\", \"Ngay_Tam_Giam\": \"2023-07-27\", \"Trang_Thai_Co_Mat\": \"Có mặt\"}, {\"Ho_Ten\": \"Nguyễn Hoài T3\", \"Ngay_Sinh\": \"2001-09-24\", \"Noi_Cu_Tru\": \"Tổ F, khóm T, thị trấn L, huyện A, tỉnh An Giang\", \"Nghe_Nghiep\": \"Làm thuê\", \"Trinh_Do_Van_Hoa\": \"9/12\", \"Dan_Toc\": \"Kinh\", \"Gioi_Tinh\": \"Nam\", \"Ton_Giao\": \"Công Giáo\", \"Quoc_Tich\": \"Việt Nam\", \"Hoan_Canh_Gia_Dinh\": \"con ông Nguyễn Văn D và bà Huỳnh Thị H2; vợ, con: Chưa có\", \"Tien_An\": \"Không\", \"Tien_Su\": \"Không\", \"Ngay_Tam_Giam\": \"2023-07-27\", \"Trang_Thai_Co_Mat\": \"Có mặt\"}, {\"Ho_Ten\": \"Lý Thị H3\", \"Ngay_Sinh\": \"1976-10-30\", \"Noi_Cu_Tru\": \"Số D C, khóm E, phường C, thành phố C, tỉnh An Giang\", \"Nghe_Nghiep\": \"Kinh doanh\", \"Trinh_Do_Van_Hoa\": \"9/12\", \"Dan_Toc\": \"Kinh\", \"Gioi_Tinh\": \"Nữ\", \"Ton_Giao\": \"Đạo Phật\", \"Quoc_Tich\": \"Việt Nam\", \"Hoan_Canh_Gia_Dinh\": \"con ông Lý Chập L và bà La Thị T4; chồng là Trần Lâm V và có 02 con\", \"Tien_An\": \"Không\", \"Tien_Su\": \"Không\", \"Ngay_Tam_Giam\": \"2023-07-29\", \"Trang_Thai_Co_Mat\": \"Có mặt\"}, {\"Ho_Ten\": \"Lâm Văn P2\", \"Ngay_Sinh\": \"1983-03-08\", \"Noi_Cu_Tru\": \"Khu dân cư K, thị trấn L, huyện A, tỉnh An Giang\", \"Nghe_Nghiep\": \"Làm thuê\", \"Trinh_Do_Van_Hoa\": \"7/12\", \"Dan_Toc\": \"Kinh\", \"Gioi_Tinh\": \"Nam\", \"Ton_Giao\": \"Đạo Phật\", \"Quoc_Tich\": \"Việt Nam\", \"Hoan_Canh_Gia_Dinh\": \"con ông Lâm Gia R và bà Nguyễn Thị S2; vợ là Hà Thị Thúy A và có 03 con\", \"Tien_An\": \"Không\", \"Tien_Su\": \"Không\", \"Trang_Thai_Co_Mat\": \"Có mặt\"}]",
        "Synthetic_summary_2": "[\"Thưa luật sư, từ tháng 02/2023 đến ngày 25/7/2023, tôi và chị Lý Thị H3 đã thỏa thuận với hai người tên L1 và S3 bên Campuchia để nhận vàng nữ trang cũ hoặc vàng thỏi từ đó vận chuyển trái phép về Việt Nam để gia công thành vàng nữ trang mới, hưởng tiền công từ 70.000 đến 130.000 đồng/lượng. Tôi thuê nhóm của Hà Văn S vận chuyển, trả tiền công mỗi lần vận chuyển vàng thành phẩm sang Campuchia là 10.000 đồng/lượng. Cụ thể, ngày 25/7/2023, tôi và chị H3 đã giao cho S và P2 nhận khoảng 220 lượng vàng thành phẩm (gồm 170 lượng vàng 18kara 59% và 50 lượng hột đính đá) cùng 2.200.000 đồng tiền công tại tiệm V5 Trà của tôi, và giao cho T3 nhận 110 lượng vàng thành phẩm (gồm 67 lượng vàng vàng 18kara 59% và 43 lượng vàng hột đính đá) cùng 1.100.000 đồng tiền công tại tiệm V5. Ngoài ra, trong số vàng bị bắt giữ trên xuồng ngày 25/7/2023, có 10 gói vàng giao cho tôi với tổng trọng lượng 10,7851 kg, trị giá 10.450.617.227 đồng. Tôi thừa nhận mình đã phạm tội nhiều lần, nhưng tôi thành khẩn khai báo, thực sự hối hận về hành vi của mình và trước đó tôi chưa từng có tiền án tiền sự nào, đây là lần đầu tôi bị đưa ra xét xử.\", \"Thưa luật sư, từ tháng 02/2023 đến ngày 25/7/2023, tôi có tham gia vận chuyển vàng trái phép qua biên giới Việt Nam - Campuchia cho Nguyễn Xuân K và Lý Thị H3 để hưởng tiền công. Tôi đã rủ P1, T3 và P2 cùng làm. Cách thức là tôi điều phối: kêu T3 và P2 nhận vàng từ các tiệm vàng Kim Yến H5, Kim Yến T9 mang về tập kết tại tiệm V6, sau đó tôi phân vàng vào bao nilon rồi giao cho P1 dùng xuồng máy chở sang Campuchia giao cho K3; ngược lại, khi nhận vàng từ Campuchia về, tôi cũng điều phối P1 nhận vàng và tôi cùng T3 canh đường. Trưa ngày 25/7/2023, tôi kêu P2 nhận khoảng 220 lượng vàng thành phẩm (170 lượng vàng 18kara 59%, 50 lượng hột đá) và 2.200.000 đồng tiền công tại tiệm V5 Trà của K, đồng thời kêu T3 nhận 110 lượng vàng thành phẩm (67 lượng vàng 18kara 59%, 43 lượng hột đá) và 1.100.000 đồng tiền công tại tiệm V5 của H5. Sau khi tập kết về tiệm V6, tôi cùng T3 cho vàng vào bao nilon trắng giao P1 chở sang Campuchia. Đến chiều tối cùng ngày, tôi kêu P1 sang Campuchia nhận vàng mang về Việt Nam nhưng P1 bị bắt, trên xuồng có 14 gói vàng với tổng giá trị 16.342.868.391 đồng. Tôi biết mình sai nên ngày 25/7/2023 tôi đã cùng T3 và P2 đến Công an tự thú. Tôi trước giờ là người có nhân thân tốt, chưa từng phạm tội hay bị xử lý hình sự lần nào, nên tôi rất hối hận và mong luật sư giúp tôi vì tôi đã thành khẩn khai báo và tự thú.\", \"Thưa luật sư, tôi là Nguyễn Tấn P1. Từ tháng 02/2023 đến ngày 25/7/2023, tôi được Hà Văn S rủ rê tham gia vận chuyển vàng trái phép qua lại biên giới Việt Nam - Campuchia bằng xuồng máy. Tôi đã thực hiện vận chuyển nhiều lần, trong đó lần cuối cùng vào trưa ngày 25/7/2023, tôi vận chuyển khoảng 220 lượng vàng thành phẩm (gồm 170 lượng vàng 18kara 59% và 50 lượng hột đính đá) cùng 110 lượng vàng thành phẩm (gồm 67 lượng vàng 18kara 59% và 43 lượng vàng thành phẩm hột đính đá) sang Campuchia giao cho K3. Đến chiều tối cùng ngày, tôi sang Campuchia nhận 01 bao nylon màu đen chứa vàng gồm 14 gói (trong đó 10 gói giao cho Nguyễn Xuân K, 4 gói giao cho Lý Thị H3 và 1 gói ký hiệu Kim Yến 3) với tổng giá trị 16.342.868.391 đồng để mang về Việt Nam thì bị Công an phát hiện. Lúc đó vì quá sợ hãi nên tôi đã nhảy xuống sông bỏ trốn, nhưng đến ngày 26/7/2023 tôi đã đến cơ quan Công an đầu thú. Tôi trước giờ là người có nhân thân tốt, chưa từng phạm tội hay bị xử lý hành chính, và đây là lần đầu tôi bị đưa ra xét xử. Tôi rất hối hận về hành vi của mình và đã thành khẩn khai báo mọi sự việc với cơ quan điều tra.\", \"Thưa luật sư, tôi là Nguyễn Hoài T3. Từ tháng 02/2023 đến ngày 25/7/2023, tôi cùng với Hà Văn S, Lâm Văn P2 và Nguyễn Tấn P1 tham gia vận chuyển vàng trái phép qua biên giới Việt Nam - Campuchia. Tôi và P2 có nhiệm vụ nhận vàng từ các tiệm vàng Kim Yến H5 và Kim Yến T9 để đưa về tiệm V6, sau đó cùng S phân loại và giao cho các tiệm vàng V5 của H5 và V5 Trà của K. Khi P1 vận chuyển vàng, tôi và S còn làm nhiệm vụ canh đường. Tôi đã thực hiện việc này nhiều lần. Vào trưa ngày 25/7/2023, tôi đến tiệm V5 gặp H5 nhận 110 lượng vàng thành phẩm (gồm 67 lượng vàng 18kara 59% và 43 lượng hột đính đá không giá trị) cùng 1.100.000 đồng tiền công, sau đó đưa về tiệm V6 để S và tôi cùng cho vào bao nilon trắng giao cho P1 vận chuyển sang Campuchia. Tôi biết mình đã phạm tội nhiều lần, nhưng tôi đã tự thú vào ngày 25/7/2023, thành khẩn khai báo và thực sự hối hận về hành vi của mình. Trước đó, tôi chưa từng phạm tội hay bị tòa án xét xử, nhân thân tôi vốn tốt, mong luật sư giúp tôi được giảm nhẹ hình phạt.\", \"Thưa luật sư, tôi là Lý Thị H3, chủ tiệm vàng V5. Từ tháng 02/2023 đến ngày 25/7/2023, tôi và Nguyễn Xuân K đã thỏa thuận với L1 và S3 bên Campuchia để nhận vàng nữ trang cũ hoặc vàng thỏi vận chuyển trái phép về Việt Nam để gia công thành sản phẩm mới với tiền công từ 70.000 đến 130.000 đồng/lượng. Tôi cùng K thuê nhóm Hà Văn S vận chuyển, trong đó tôi trả tiền công vận chuyển từ Việt Nam sang Campuchia là 10.000 đồng/lượng. Cụ thể, trưa ngày 25/7/2023, tôi đã giao cho T3 nhận 110 lượng vàng thành phẩm (gồm 67 lượng vàng 18kara 59% và 43 lượng hột đính đá) cùng 1.100.000 đồng tiền công để vận chuyển sang Campuchia. Cũng trong ngày hôm đó, lực lượng chức năng bắt giữ một chuyến hàng về, trong đó có 04 gói vàng giao cho tôi với tổng trọng lượng 5,174 kg, trị giá 5.199.767.780 đồng. Tôi thừa nhận mình đã phạm tội nhiều lần, nhưng tôi xin luật sư xem xét giúp vì tôi thành khẩn khai báo, thực sự hối hận về hành vi của mình, và trước đó tôi vốn có nhân thân tốt, chưa từng có tiền án tiền sự hay bị tòa án nào xét xử.\", \"Thưa luật sư, tôi là Lâm Văn P2. Từ tháng 02/2023 đến ngày 25/7/2023, tôi cùng với Hà Văn S, Nguyễn Hoài T3 và Nguyễn Tấn P1 tham gia vận chuyển vàng trái phép qua biên giới Việt Nam - Campuchia. Theo sự phân công của S, tôi và T3 có nhiệm vụ nhận vàng từ các tiệm vàng Kim Yến H5 và Kim Yến T9 để đưa về tập kết tại tiệm V6. Đặc biệt, vào trưa ngày 25/7/2023, tôi được S kêu đến tiệm V5 Trà của K gặp D2 để nhận khoảng 220 lượng vàng thành phẩm (trong đó 170 lượng vàng 18kara 59% và 50 lượng hột đính đá không giá trị) cùng 2.200.000 đồng tiền công, sau đó đem về tiệm V6 để S và T3 đóng gói giao cho P1 vận chuyển sang Campuchia. Tôi rất hối hận về hành vi của mình và đã tự thú vào ngày 25/7/2023. May mắn là trước đây tôi chưa từng phạm tội, chưa có tiền án tiền sự và đây là lần đầu tôi bị đưa ra xét xử, nên tôi mong luật sư giúp tôi nhận được sự khoan hồng của pháp luật.\"]"
      },
