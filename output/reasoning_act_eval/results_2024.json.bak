      "llm_input_payload": {
        "THONG_TIN_CHUNG.Thong_Tin_Bi_Cao": "[{\"Ho_Ten\": \"Tăng Sơ T\", \"Ngay_Sinh\": \"1969-01-02\", \"Noi_Cu_Tru\": \"A D, Phường H, Quận A, Thành phố Hồ Chí Minh\", \"Nghe_Nghiep\": \"Lao động tự do\", \"Trinh_Do_Van_Hoa\": \"02/12\", \"Dan_Toc\": \"Hoa\", \"Gioi_Tinh\": \"Nam\", \"Ton_Giao\": \"Không\", \"Quoc_Tich\": \"Việt Nam\", \"Hoan_Canh_Gia_Dinh\": \"Con ông Lâm K (đã chết) và bà Tăng A (đã chết); chưa có vợ, con\", \"Tien_An\": \"Bản án số 307/HSST ngày 05/10/1999 xử phạt 12 tháng tù cho hưởng án treo về tội \\\"Gây rối trật tự công cộng\\\"; Bản án số 235/HSST ngày 26/10/2000 xử phạt 12 tháng tù về tội \\\"Bắt giữ người trái pháp luật\\\", tổng hợp hình phạt chung 24 tháng tù\", \"Tien_Su\": \"Quyết định số 0007148/QĐ-XPHC ngày 15/3/2021 xử phạt hành chính về hành vi hủy hoại tài sản của người khác, mức phạt 3.500.000 đồng\", \"Ngay_Tam_Giam\": \"2024-01-05\", \"Trang_Thai_Co_Mat\": \"Có mặt\"}, {\"Ho_Ten\": \"Lê Thanh B\", \"Ngay_Sinh\": \"1997-08-30\", \"Noi_Cu_Tru\": \"B T, khu phố A, phường B, quận B, Thành phố Hồ Chí Minh\", \"Nghe_Nghiep\": \"Lao động tự do\", \"Trinh_Do_Van_Hoa\": \"09/12\", \"Dan_Toc\": \"Kinh\", \"Gioi_Tinh\": \"Nam\", \"Ton_Giao\": \"Không\", \"Quoc_Tich\": \"Việt Nam\", \"Hoan_Canh_Gia_Dinh\": \"Con ông Lê Sơn T1 và bà Trần Thị T2; chưa có vợ, con\", \"Tien_An\": \"Không\", \"Tien_Su\": \"Không\", \"Ngay_Tam_Giam\": \"2024-01-05\", \"Trang_Thai_Co_Mat\": \"Có mặt\"}]",
        "Synthetic_summary_2": "[\"Thưa luật sư, tôi là Tăng Sơ T, tôi muốn tường trình lại việc tôi cho chị Lý Thị X Tụi vay tiền với lãi suất cao. Lần thứ nhất vào ngày 27/12/2021, tôi cho chị X vay 20.000.000 đồng theo hình thức vay tiền đứng, mỗi ngày đóng 100.000 đồng, tương ứng 15%/tháng. Từ ngày 27/12/2021 đến 01/3/2023, chị X đã đóng lãi 429 ngày với số tiền 42.900.000 đồng, khiến tôi thu lợi bất chính 38.133.333 đồng. Lần thứ hai vào ngày 30/12/2021, tôi cho chị X vay 50.000.000 đồng tiền đứng, mỗi ngày đóng 250.000 đồng, tương ứng 15%/1 tháng. Từ ngày 30/12/2021 đến ngày 01/3/2023, chị X đã đóng lãi 426 ngày với số tiền 106.500.000 đồng, dẫn đến số tiền thu lợi bất chính là 94.666.667 đồng. Tổng cộng tôi đã thu lợi bất chính 132.800.000 đồng qua 02 lần cho vay. Tôi đã thành khẩn khai báo toàn bộ sự việc với cơ quan điều tra và thực sự hối hận về hành vi của mình. Hiện tại, tôi cũng đã nộp lại toàn bộ số tiền thu lợi bất chính 132.800.000 đồng để khắc phục hậu quả.\", \"Thưa luật sư, tôi là Lê Thanh B, tôi làm người giúp việc cho Tăng Sơ T và được giao nhiệm vụ thu tiền góp hằng ngày của những người vay tiền từ T tại địa chỉ I D, Phường H, Quận A, Thành phố Hồ Chí Minh. Tôi có thu tiền của chị Lý Thị Xía T3 thông qua hình thức giao trực tiếp và chuyển khoản ngân hàng, sau đó tổng hợp lại để đưa cho T. Cụ thể, tôi tham gia vào việc thu lãi cho hai khoản vay của chị T3: khoản vay 20.000.000 đồng ngày 27/12/2021 và khoản vay 50.000.000 đồng ngày 30/12/2021. Tôi được trả công 200.000 đồng/ngày và tổng số tiền tôi thu lợi bất chính là 85.800.000 đồng. Tôi biết mình đã phạm tội 02 lần trở lên, nhưng tôi chỉ là người làm thuê, đây là lần đầu tôi phạm tội và mức độ ít nghiêm trọng, nên tôi mong luật sư giúp tôi vì tôi đã thành khẩn khai báo và thực sự hối hận về những việc mình đã làm.\"]"
      },
