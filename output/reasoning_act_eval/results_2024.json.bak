      "llm_input_payload": {
        "THONG_TIN_CHUNG.Thong_Tin_Bi_Cao": "[{\"Ho_Ten\": \"Hạng Thị T\", \"Ngay_Sinh\": \"1977\", \"Noi_Cu_Tru\": \"Bản Cột Mốc, xã T, huyện V, tỉnh Sơn La\", \"Nghe_Nghiep\": \"Trồng trọt\", \"Trinh_Do_Van_Hoa\": \"Không biết chữ\", \"Dan_Toc\": \"Mông\", \"Gioi_Tinh\": \"Nữ\", \"Ton_Giao\": \"Không\", \"Quoc_Tich\": \"Việt Nam\", \"Hoan_Canh_Gia_Dinh\": \"con ông Hạng A D và bà Lầu Thị D1; Bị cáo có chồng là Mùa A V (đã chết), hiện đang chung sống như vợ chồng với Thào A L và có 06 con\", \"Tien_An\": \"Không\", \"Tien_Su\": \"Không\", \"Ngay_Tam_Giam\": \"2023-08-18\", \"Trang_Thai_Co_Mat\": \"Có mặt\"}, {\"Ho_Ten\": \"Phàng Thị V1\", \"Ngay_Sinh\": \"1999\", \"Noi_Cu_Tru\": \"Bản Pưng, huyện S, tỉnh Hủa Phăn, nước CHDCND Lào\", \"Nghe_Nghiep\": \"Trồng trọt\", \"Trinh_Do_Van_Hoa\": \"05/12\", \"Dan_Toc\": \"Mông\", \"Gioi_Tinh\": \"Nữ\", \"Ton_Giao\": \"Không\", \"Quoc_Tich\": \"Lào\", \"Hoan_Canh_Gia_Dinh\": \"con ông Phàng A C và bà Thào Thị C1; bị cáo có chồng là Ly A S và 04 con\", \"Tien_An\": \"Không\", \"Tien_Su\": \"Không\", \"Ngay_Tam_Giam\": \"2023-08-18\", \"Trang_Thai_Co_Mat\": \"Có mặt\"}, {\"Ho_Ten\": \"Cứ Thị C2\", \"Ngay_Sinh\": \"1999\", \"Noi_Cu_Tru\": \"Bản H, huyện S, tỉnh Hủa Phăn, nước CHDCND Lào\", \"Nghe_Nghiep\": \"Trồng trọt\", \"Trinh_Do_Van_Hoa\": \"05/12\", \"Dan_Toc\": \"Mông\", \"Gioi_Tinh\": \"Nữ\", \"Ton_Giao\": \"Không\", \"Quoc_Tich\": \"Lào\", \"Hoan_Canh_Gia_Dinh\": \"con ông Cứ A V2 (đã chết) và bà Vàng Thị S1; bị cáo có chồng là Ly A P và 04 con\", \"Tien_An\": \"Không\", \"Tien_Su\": \"Không\", \"Ngay_Tam_Giam\": \"2023-08-18\", \"Trang_Thai_Co_Mat\": \"Có mặt\"}]",
        "Synthetic_summary_2": "[\"Thưa luật sư, khoảng tháng 7/2023, vì muốn có tiền tiêu xài, tôi đã gọi điện bảo Phàng Thị V1 tìm mua một bánh Heroine để mang sang tỉnh Đắk Lắk bán rồi chia lãi. Đến khoảng tháng 8/2023, tôi hẹn V1 mang ma túy sang Việt Nam và đón tại bản C, xã T, huyện V, tỉnh Sơn La. Ngày 15/8/2023, tôi nhận bánh Heroine từ V1 và Cứ Thị C2, sau đó cả ba cùng về nhà tôi ngủ lại. Sáng ngày 16/8/2023, chúng tôi cùng quấn bánh Heroine vào trong chiếc balo màu xanh của tôi. Đến 19 giờ cùng ngày, tôi đeo balo chứa ma túy, được con trai là Mùa A C4 chở đến ngã ba V thuộc bản B, xã V, huyện V để đón xe khách đi Đắk Lắk. Tuy nhiên, do đón nhầm xe, khi đến khu vực rừng già thuộc xóm X, xã P, huyện M, tỉnh Hòa Bình, cả ba chúng tôi đã xuống xe và vì sợ bị phát hiện, tôi cùng V1 và C2 đã đem xách balo đựng bánh Heroine vào rừng ven đường rồi phủ đất lên để cất giấu. Gần sáng ngày 17/8/2023, chúng tôi đi bộ về xã L, huyện V. Đến ngày 18/8/2023, vì nhận thức được sai lầm, tôi đã chủ động đến Công an huyện V, tỉnh Sơn La tự thú. Tôi đã thành khẩn khai báo, ăn năn hối cải và tích cực giúp cơ quan điều tra làm rõ hành vi của V1 và C2. Lúc phạm tội, tôi đang nuôi con dưới 36 tháng tuổi, mong luật sư xem xét các tình tiết này để giảm nhẹ hình phạt cho tôi. Tổng khối lượng ma túy thu giữ được là 315,06 gam Heroine.\", \"Thưa luật sư, khoảng tháng 7/2023, tôi nghe Hạng Thị T gọi điện bảo tôi tìm mua một bánh Heroine để mang sang tỉnh Đắk Lắk bán kiếm lời thì tôi đồng ý. Tôi có nhờ Cứ Thị C2 tìm mua, sau đó C2 đặt mua 01 bánh Heroine của một người phụ nữ dân tộc Mông với giá 50 triệu Kíp Lào, trong đó tôi đã đưa cho C2 một sợi dây chuyền vàng để trả trước 20 triệu Kíp Lào cùng với 10 triệu Kíp Lào C2 vay được. Tôi và C2 mang bánh Heroine này sang Việt Nam vào ngày 15/8/2023 thông qua một thuê một người vận chuyển với tiền công 1 triệu đồng. Đến ngày 16/8/2023, tôi cùng T và C2 quấn bánh ma túy vào balo của T rồi cùng đi xe khách đi Đắk Lắk nhưng do đón nhầm xe nên khi đến xóm X, xã P, huyện M, tỉnh Hòa Bình thì chúng tôi xuống xe và đem bánh ma túy đi chôn giấu trong rừng ven đường. gần sáng ngày 17/8/2023 chúng tôi đi bộ về xã L, huyện V. Đến ngày 18/8/2023, tôi và C2 bị bắt giữ khi đang ở khu vực ngã ba huyện V. Cơ quan điều tra đã thu giữ 315,06 gam Heroine. Tôi biết mình sai rồi, tôi thành khẩn khai báo và ăn năn hối cải, mong luật sư giúp tôi vì tôi còn đang nuôi con nhỏ dưới 36 tháng tuổi.\", \"Thưa luật sư, khoảng tháng 7/2023, tôi nghe Phàng Thị V1 rủ rê mua ma túy về bán kiếm lời nên tôi đã đồng ý. Tôi có liên hệ với một người phụ nữ dân tộc Mông để đặt mua 01 bánh Heroine với giá 50 triệu Kíp Lào, trong đó tôi trả trước 20 triệu Kíp Lào bằng sợi dây chuyền vàng của V1 và 10 triệu Kíp Lào vay mượn, số còn lại hẹn trả sau. Sau khi nhận ma túy, tôi cất giấu tại nhà. Đến ngày 15/8/2023, tôi cùng V1 vận chuyển bánh Heroine này sang Việt Nam, thuê người vận chuyển qua biên giới với giá 1 triệu đồng. Sau đó, tôi cùng V1 và Hạng Thị T quấn bánh Heroine vào balo của T rồi cùng đi xe khách đi Đắk Lắk. Tuy nhiên, do đón nhầm xe, khi đến xóm X, xã P, huyện M, tỉnh Hòa Bình, chúng tôi đã xuống xe và vì sợ bị phát hiện, cả ba đã đem bánh Heroine cất giấu trong rừng ven đường rồi phủ đất lên. Đến ngày 18/8/2023, tôi và V1 bị bắt giữ. Cơ quan điều tra đã thu giữ 315,06 gam Heroine. Tôi biết mình đã sai và rất hối hận, từ đầu đến cuối tôi đã thành khẩn khai báo mọi chuyện. Tôi mong luật sư xem xét giúp tôi vì lúc phạm tội tôi đang nuôi con nhỏ dưới 36 tháng tuổi.\"]"
