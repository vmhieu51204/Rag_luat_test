l,\\n            \"Tinh_tiet_ap_dung\": \"Người có chức vụ, quyền hạn trong doanh nghiệp ngoài Nhà nước mà tham ô tài sản.\",\\n            \"Bo_Luat_Va_Van_Ban_Khac\": \"BLHS\"\\n          },\\n          {\\n            \"Dieu\": \"51\",\\n            \"Khoan\": \"1\",\\n            \"Diem\": \"b\",\\n            \"Tinh_tiet_ap_dung\": \"Tự nguyện bồi thường 100.000.000 đồng để khắc phục hậu quả.\",\\n            \"Bo_Luat_Va_Van_Ban_Khac\": \"BLHS\"\\n          },\\n          {\\n            \"Dieu\": \"51\",\\n            \"Khoan\": \"1\",\\n            \"Diem\": \"s\",\\n            \"Tinh_tiet_ap_dung\": \"Thành khẩn khai báo, ăn năn hối cải.\",\\n            \"Bo_Luat_Va_Van_Ban_Khac\": \"BLHS\"\\n          },\\n          {\\n            \"Dieu\": \"54\",\\n            \"Khoan\": \"1\",\\n            \"Diem\": null,\\n            \"Tinh_tiet_ap_dung\": \"Có ít nhất hai tình tiết giảm nhẹ tại Khoản 1 Điều 51, cho phép quyết định hình phạt dưới mức thấp nhất của khung hình phạt.\",\\n            \"Bo_Luat_Va_Van_Ban_Khac\": \"BLHS\"\\n          }\\n        ],\\n        \"Phat_Tu\": \"06 năm tù\",\\n        \"Phat_Tien\": null,\\n        \"Trach_Nhiem_Dan_Su\": \"Buộc bị cáo hoàn trả số tiền đã chiếm đoạt còn lại cho Công ty cổ phần D2 (364.630.000 đồng trừ đi 100.000.000 đồng đã bồi thường).\"\\n      }\\n    ],\\n    \"Xu_Ly_Vat_Chung\": null\\n  }\\n}\\n```', refusal=None, role='assistant', annotations=None, audio=None, function_call=None, tool_calls=None, reasoning=None), native_finish_reason='stop')], created=1781214043, model='google/gemma-4-31b-it-20260402:free', object='chat.completion', service_tier=None, system_fingerprint='vllm-0.21.1rc1.dev262+g33d7cbe02-tp8-dd71347d', usage=CompletionUsage(completion_tokens=2456, prompt_tokens=12402, total_tokens=14858, completion_tokens_details=CompletionTokensDetails(accepted_prediction_tokens=None, audio_tokens=0, reasoning_tokens=0, rejected_prediction_tokens=None, image_tokens=0), prompt_tokens_details=PromptTok