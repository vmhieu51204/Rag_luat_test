ich_Phap_Ly\": \"Bị cáo cùng đồng phạm cho vay với lãi suất cao, thu lợi bất chính 15.000.000 đồng (trong tổng số 35.000.000 đồng). Tình tiết giảm nhẹ: là người dân tộc thiểu số, sống ở vùng đặc biệt khó khăn (điểm g), phạm tội lần đầu và thuộc trường hợp ít nghiêm trọng (điểm i), thành khẩn khai báo, ăn năn hối cải (điểm s) và tự nguyện nộp lại toàn bộ số tiền thu lợi bất chính (điểm b).\",\\n        \"Toi_Danh\": \"Tội cho vay lãi nặng trong giao dịch dân sự\",\\n        \"Applied_Law_Clauses\": [\\n          {\\n            \"Dieu\": \"201\",\\n            \"Khoan\": \"1\",\\n            \"Diem\": null,\\n            \"Tinh_tiet_ap_dung\": \"Cho vay lãi suất gấp 05 lần mức lãi suất cao nhất quy định trong Bộ luật Dân sự, thu lợi bất chính từ 30 triệu đến dưới 100 triệu đồng (tính chung cho nhóm đồng phạm).\",\\n            \"Bo_Luat_Va_Van_Ban_Khac\": \"BLHS\"\\n          },\\n          {\\n            \"Dieu\": \"51\",\\n            \"Khoan\": \"1\",\\n            \"Diem\": \"b\",\\n            \"Tinh_tiet_ap_dung\": \"Tự nguyện nộp lại toàn bộ số tiền lãi bất chính.\",\\n            \"Bo_Luat_Va_Van_Ban_Khac\": \"BLHS\"\\n          },\\n          {\\n            \"Dieu\": \"51\",\\n            \"Khoan\": \"1\",\\n            \"Diem\": \"g\",\\n            \"Tinh_tiet_ap_dung\": \"Là người dân tộc thiểu số, sống ở vùng đặc biệt khó khăn.\",\\n            \"Bo_Luat_Va_Van_Ban_Khac\": \"BLHS\"\\n          },\\n          {\\n            \"Dieu\": \"51\",\\n            \"Khoan\": \"1\",\\n            \"Diem\": \"i\",\\n            \"Tinh_tiet_ap_dung\": \"Phạm tội lần đầu và thuộc trường hợp ít nghiêm trọng.\",\\n            \"Bo_Luat_Va_Van_Ban_Khac\": \"BLHS\"\\n          },\\n          {\\n            \"Dieu\": \"51\",\\n            \"Khoan\": \"1\",\\n            \"Diem\": \"s\",\\n            \"Tinh_tiet_ap_dung\": \"Thành khẩn khai báo, ăn năn hối cải.\",\\n            \"Bo_Luat_Va_Van_Ban_Khac\": \"BLHS\"\\n          }\\n        ],\\n        \"Phat_Tu\": \"Cả