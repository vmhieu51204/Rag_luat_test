      "llm_input_payload": {
        "THONG_TIN_CHUNG.Thong_Tin_Bi_Cao": "[{\"Ho_Ten\": \"Bùi Hồng Q\", \"Ngay_Sinh\": \"1983-09-27\", \"Noi_Cu_Tru\": \"B, tổ B, phường Đ, quận L, thành phố Hà Nội\", \"Nghe_Nghiep\": \"Lao động tự do\", \"Trinh_Do_Van_Hoa\": \"11/12\", \"Dan_Toc\": \"Kinh\", \"Gioi_Tinh\": \"Nam\", \"Ton_Giao\": \"Không\", \"Quoc_Tich\": \"Việt Nam\", \"Hoan_Canh_Gia_Dinh\": \"chưa có vợ và có 01 con\", \"Tien_An\": \"03 tiền án: Năm 2008 bị Toà án nhân dân thành phố Hà Nội xử phạt 36 tháng tù giam về tội \\\"Cướp giật tài sản\\\"; Năm 2012 bị Toà án nhân dân huyện Gia Lâm, thành phố Hà Nội xử phạt 42 tháng từ giam về tội \\\"Tàng trữ trái phép chất ma túy\\\"; Năm 2017 bị Toà án nhân dân quận Ba Đình, thành phố Hà Nội xử phạt 07 năm tù giam về tội \\\"Tàng trữ trái phép chất ma túy\\\"\", \"Tien_Su\": \"Không\", \"Chi_Tiet_Nhan_Than\": \"Ngày 04/10/2001, Công an phường Đ, quận L, thành phố Hà Nội xử phạt vi phạm hành chính về hành vi \\\"Gây rối trật tự công cộng\\\". Ngày 01/01/2004, Công an phường G, quận L, thành phố Hà Nội xử phạt vi phạm hành chính số tiền 100.000đ về hành vi \\\"Đánh nhau gây rối trật tự công cộng\\\". Năm 2004 bị đưa vào cơ sở cai nghiện bắt buộc, thời hạn 24 tháng.\", \"Ngay_Tam_Giam\": \"2023-06-06\", \"Trang_Thai_Co_Mat\": \"Có mặt\"}]",
        "Synthetic_summary_2": "[\"Thưa luật sư, tôi là Bùi Hồng Q, tôi xin tường trình lại sự việc như sau: Vào khoảng 8 giờ ngày 06/6/2023, tôi một mình bắt xe buýt đến khu dân cư OCEAN PARK, xã Đ, huyện G, TP Hà Nội để mua ma túy về bán kiếm lời. Tôi đã mua của một người phụ nữ khoảng 30 tuổi 100 viên thuốc lắc và một lượng ma túy tổng hợp Ketamine với tổng số tiền 18.000.000 đồng. Sau đó, tôi bắt xe buýt về nhà rồi gọi cho Vi Tiến L để nhờ lái xe ô tô BKS 30K-273.76 chở tôi đi Thái Nguyên. Khoảng 10 giờ cùng ngày, tôi và L gặp nhau gặp nhau tại đầu đường Q, phường G, quận L, TP Hà Nội để khởi hành. Tôi không hề nói cho L biết việc mình mang theo ma túy. Khi xe dừng đỗ tại nút giao Y, thành phố P vào lúc 11 giờ, tôi định xuống xe để tìm người mua, nhưng đã bị công an kiểm tra và bắt giữ. Khi đó, trong túi quần sooc của tôi có 100 viên nén màu xanh (33,24 gam MDMA) và 12,39 gam Ketamine. Công an cũng thu giữ của tôi 6.000.000 đồng, 2 điện thoại di động và 1 thẻ VISA T8. Tôi biết mình đã sai, nay tôi thành khẩn khai báo và ăn năn hối cải. Tôi cũng mong luật sư xem xét giúp tôi vì mẹ tôi là bà Nguyễn Thị N được Chủ tịch nước tặng thưởng Huy chương kháng chiến hạng chiến hạng nhất, đây là một tình tiết giảm nhẹ cho tôi. Tuy nhiên, tôi cũng lo lắng vì trước đây tôi đã nhiều lần bị tòa án xét xử về các tội danh khác nhau nhưng chưa được xóa án tích, nên lần này tôi bị coi là tái phạm nguy hiểm.\"]"
      },
