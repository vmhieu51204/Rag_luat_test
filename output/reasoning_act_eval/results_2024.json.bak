e\": \"high\"\\n  },\\n  \"prediction\": {\\n    \"defendants\": [\\n      {\\n        \"Bi_Cao\": \"Ninh Thiên T\",\\n        \"Phan_Tich_Phap_Ly\": \"Bị cáo dùng hung khí nguy hiểm (dao kim loại) gây thương tích cho bị hại với tỷ lệ 94%, đủ yếu tố cấu thành tội Cố ý gây thương tích theo Khoản 4 Điều 134. Tình tiết giảm nhẹ bao gồm: tự nguyện đưa bị hại đi cấp cứu làm giảm bớt tác hại (Điểm a Khoản 1 Điều 51), tự nguyện bồi thường thiệt hại (Điểm b Khoản 1 Điều 51), đầu thú (Khoản 2 Điều 51), thành khẩn khai báo, ăn năn hối cải (Điểm s Khoản 1 Điều 51). Bị cáo có đơn xin giảm nhẹ từ bị hại. Tuy nhiên, bị cáo có một bản án cải tạo không giam giữ trước đó, cần xem xét tổng hợp hình phạt theo Điều 56.\",\\n        \"Toi_Danh\": \"Tội cố ý gây thương tích\",\\n        \"Applied_Law_Clauses\": [\\n          {\\n            \"Dieu\": \"134\",\\n            \"Khoan\": \"4\",\\n            \"Diem\": \"d\",\\n            \"Tinh_tiet_ap_dung\": \"Gây thương tích tỷ lệ 94% bằng hung khí nguy hiểm (dao kim loại).\",\\n            \"Bo_Luat_Va_Van_Ban_Khac\": \"BLHS\"\\n          },\\n          {\\n            \"Dieu\": \"51\",\\n            \"Khoan\": \"1\",\\n            \"Diem\": \"a\",\\n            \"Tinh_tiet_ap_dung\": \"Đưa bị hại đi cấp cứu kịp thời, ngăn chặn hậu quả chết người.\",\\n            \"Bo_Luat_Va_Van_Ban_Khac\": \"BLHS\"\\n          },\\n          {\\n            \"Dieu\": \"51\",\\n            \"Khoan\": \"1\",\\n            \"Diem\": \"b\",\\n            \"Tinh_tiet_ap_dung\": \"Đã bồi thường toàn bộ thiệt hại cho bị hại.\",\\n            \"Bo_Luat_Va_Van_Ban_Khac\": \"BLHS\"\\n          },\\n          {\\n            \"Dieu\": \"51\",\\n            \"Khoan\": \"2\",\\n            \"Diem\": null,\\n            \"Tinh_tiet_ap_dung\": \"Đầu thú sau khi gây án.\",\\n            \"Bo_Luat_Va_Van_Ban_Khac\": \"BLHS\"\\n          },\\n          {\\n            \"Dieu\": \"51\",\\n            \"Khoan\": \"1\",\\n            \"Diem\": \"s\",\\n            \"Tinh